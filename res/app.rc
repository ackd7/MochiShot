#include <winresrc.h>
#include "resource.h"

#pragma code_page(65001)

IDI_APP_ICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "MochiShot Open Source\0"
            VALUE "FileDescription", "MochiShot Lightweight Liquid Glass Screenshot Tool\0"
            VALUE "FileVersion", "1.1.0.0\0"
            VALUE "InternalName", "MochiShot.exe\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Apache-2.0\0"
            VALUE "OriginalFilename", "MochiShot.exe\0"
            VALUE "ProductName", "MochiShot\0"
            VALUE "ProductVersion", "1.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
